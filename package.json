{
  "name": "git-asana-webhook",
  "version": "0.1.0",
  "description": "Stateless GitHub-to-Asana webhook integration: syncs pull request and CI status from GitHub webhooks onto Asana tasks via custom fields and comments.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
