# ─────────────────────────────────────────────────────────────────────────────
# git-asana-webhook configuration
#
# Copy to `.env` for local development (e.g. `npm run dev` with a tool like
# direnv/dotenv, or `env $(cat .env | xargs) npm run dev`).
# In production, inject these as real environment variables / secrets.
#
# NOTE: the GitHub webhook must be configured with content type
# "application/json" and the same secret as GITHUB_WEBHOOK_SECRET.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
# Port the HTTP server listens on. Cloud Run injects PORT automatically.
PORT=8080

# ── GitHub ──────────────────────────────────────────────────────────────────
# Shared secret used to verify the X-Hub-Signature-256 header on deliveries.
GITHUB_WEBHOOK_SECRET=

# ── Short-ID extraction ─────────────────────────────────────────────────────
# Optional. Regex used to find Jira-style ticket keys (e.g. CENG-1234) in
# branch names, PR titles, and commit messages. Compiled case-insensitively.
# Default: \b[A-Z][A-Z0-9]+-\d+\b
# SHORT_ID_PATTERN=

# ── Asana: authentication & workspace ───────────────────────────────────────
# Personal Access Token (or service-account token) with access to the workspace.
ASANA_ACCESS_TOKEN=
# Workspace GID to search for tasks in (task search requires Asana premium).
ASANA_WORKSPACE_GID=

# ── Asana: "Ticket Key" text custom field ───────────────────────────────────
# GID of the text custom field that stores the short-ID (e.g. "CENG-1234").
ASANA_TICKET_KEY_FIELD_GID=

# ── Asana: "PR Status" dropdown custom field ────────────────────────────────
# GID of the dropdown field plus the GIDs of its three options.
ASANA_PR_STATUS_FIELD_GID=
ASANA_PR_STATUS_OPEN_GID=
ASANA_PR_STATUS_MERGED_GID=
ASANA_PR_STATUS_CLOSED_GID=

# ── Asana: "CI Status" dropdown custom field ────────────────────────────────
# GID of the dropdown field plus the GIDs of its three options.
ASANA_CI_STATUS_FIELD_GID=
ASANA_CI_STATUS_PENDING_GID=
ASANA_CI_STATUS_PASSED_GID=
ASANA_CI_STATUS_FAILED_GID=
